# ═══════════════════════════════════════════════════════════
# shiro-portfolio — Environment Variables (KEY-ONLY template)
# Copy to .env and fill in values. NEVER commit real values.
# ═══════════════════════════════════════════════════════════

# ─── Turso (libSQL) ──────────────────────────────────────
# Production: libsql://<db-name>-<org>.turso.io + auth token (keeps the site
# serverless + free on Netlify). Local dev: leave BOTH unset to use a local
# `file:` database at server/data/portfolio.db (no Turso account needed).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ─── Admin auth (session + seeded admin) ─────────────────
# Session signing secret — 32+ random chars. The seeded admin user is created on
# first boot from the next two vars (bcrypt-hashed; never overwritten).
NUXT_ADMIN_SECRET=
NUXT_ADMIN_USERNAME=
NUXT_ADMIN_PASSWORD=

# ─── Cloudflare R2 (production thumbnail uploads) ─────────
# If set, admin uploads go to R2 (durable, serverless) instead of local public/.
# R2_ACCOUNT_ID      — 32-char hex from the R2 dashboard URL
# R2_ACCESS_KEY_ID   — from an R2 API token (not the global Cloudflare key)
# R2_SECRET_ACCESS_KEY — from the same R2 API token
# R2_BUCKET          — bucket name (e.g. portfolio)
# R2_PUBLIC_URL      — public base URL for the bucket (e.g. https://pub-xxxx.r2.dev)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
